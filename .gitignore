*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
.build/
.swiftpm/
*.xcuserstate
*.xcscmblueprint
Packages/
Package.resolved

# ── macOS ────────────────────────────────────────────────────────────
.DS_Store

